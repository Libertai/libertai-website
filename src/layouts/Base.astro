---
import "../styles/base.css";

interface Props {
	title: string;
	description: string;
	path: string;
	lang?: string;
}
const { title, description, path, lang = "en" } = Astro.props;

const BASE_URL = "https://libertai.io";
const fullTitle = path === "/" ? "LibertAI - Private intelligence you own" : `${title} | LibertAI`;
const url = `${BASE_URL}${path}`;
const ogImage = `${BASE_URL}/og.png`;

const orgSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			name: "LibertAI",
			url: BASE_URL,
			logo: `${BASE_URL}/logo-512.png`,
			description:
				"Decentralized, private AI platform powered by Aleph Cloud. Open-source models, confidential inference API, and AI agents.",
			sameAs: [
				"https://x.com/Libertai_DAI",
				"https://github.com/libertai",
				"https://t.me/libertai",
				"https://linkedin.com/company/libertai",
				"https://discord.gg/alephcloud",
			],
		},
		{ "@type": "WebSite", name: "LibertAI", url: BASE_URL },
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<link href="/favicon.ico" rel="icon" />
		<meta content="width=device-width, initial-scale=1.0" name="viewport" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={url} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="LibertAI" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="LibertAI - Private intelligence you own" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@Libertai_DAI" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Agent / API discovery (RFC 8288 link relations) -->
		<link rel="api-catalog" href="/.well-known/api-catalog" type="application/linkset+json" />
		<link rel="sitemap" href="/sitemap.xml" type="application/xml" />
		<link rel="describedby" href="/llms.txt" type="text/plain" />

		<!-- Font preloading -->
		<link rel="preload" href="/fonts/Satoshi-Medium.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
		<script
			is:inline
			defer
			src="https://analytics-01.2n6.io/script.js"
			data-website-id="1060ebb7-81d2-4b7a-b14d-b837e8ccc6ea"></script>
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
