	<script>
		const REGION_URL = "https://inference.api.libertai.io/payments/region";
		const SYMBOLS: Record<string, string> = { EUR: "€", USD: "$" };

		fetch(REGION_URL)
			.then((r) => (r.ok ? r.json() : null))
			.then((region) => {
				const symbol = region && SYMBOLS[region.currency];
				if (!symbol) return;
				document.querySelectorAll<HTMLElement>("#pricing .cur").forEach((el) => {
					el.textContent = symbol;
				});
				const vat = document.querySelector<HTMLElement>("#pricing .vatnote");
				if (vat) {
					vat.textContent = region.currency === "EUR" && region.vat_rate > 0 ? "TVA incluse." : "Hors taxes.";
				}
			})
			.catch(() => {});
	</script>
