---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/services.css";
---

<Base
	title="Private AI for Companies"
	description="Confidential AI for companies: TEE-attested inference, private agents, team tooling and private web search. OpenAI-compatible, open-weight models, from an EU company. Nothing stored, nothing trained on."
	path="/services"
	alt="/fr/services"
>
	<Nav active="services" alt="/fr/services" />
	<header class="hero" id="top">
		<div class="wrap">
			<div class="hero-fade eyebrow" style="--d:60ms">
				<span class="dot"></span><span class="mono" style="color:var(--ink)">LibertAI for companies</span>
			</div>
			<h1 class="hero-fade" style="--d:150ms">Private AI<br />for your <em>company</em>.</h1>
			<p class="hero-fade sub" style="--d:250ms">
				Your teams want AI. Your data can't go to labs that log prompts and train on them. LibertAI runs open-weight
				models behind an <b>OpenAI-compatible</b> API, confidential by design and <b>attested in hardware</b>.
			</p>
			<div class="hero-fade ctas" style="--d:350ms">
				<a class="btn acc" href="mailto:contact@libertai.io">Contact us</a>
				<a class="btn ghost" href="#offer">See what we offer</a>
			</div>
			<div class="hero-fade avail" style="--d:430ms">Nothing stored · Nothing trained on · <b>EU company</b></div>

			<div class="hero-fade stage" style="--d:540ms">
				<div class="stk">
					<div class="hd">
						<span class="g"></span>your company · private stack<span class="rt">TEE · remote attestation</span>
					</div>
					<div class="r">
						<span class="nm">Confidential inference</span><span class="ep">api.libertai.io/v1</span><span class="tag"
							>OpenAI-compatible</span
						>
					</div>
					<div class="r">
						<span class="nm">Private agents</span><span class="ep">liberclaw.ai</span><span class="tag">Always-on</span>
					</div>
					<div class="r">
						<span class="nm">Chat &amp; Code</span><span class="ep">chat · code.libertai.io</span><span class="tag"
							>Private endpoint</span
						>
					</div>
					<div class="r">
						<span class="nm">Web search</span><span class="ep">api.libertai.io/v1/search</span><span class="tag"
							>Consensus-ranked</span
						>
					</div>
				</div>
			</div>
		</div>
	</header>

	<div class="trust">
		<div class="wrap reveal">
			<p>Built for the data you can't leak</p>
			<div class="row">
				<span>Source code</span><span>Contracts</span><span>Customer records</span><span>Internal docs</span><span
					>Financials</span
				>
			</div>
		</div>
	</div>

	<section class="blk" id="offer" style="padding-bottom:40px">
		<div class="wrap">
			<div class="center reveal">
				<span class="mono k">What we offer</span>
				<h2 class="big">One private stack, from API to agents.</h2>
				<p class="lead">
					Use one piece or all four. The same guarantees hold across the stack: nothing stored, nothing trained on, no
					profile built on your teams.
				</p>
			</div>

			<div class="feat reveal">
				<div class="txt">
					<span class="mono k">Confidential inference API</span>
					<h3>Send sensitive data. Keep it yours.</h3>
					<p>
						The leading open-weight models behind a drop-in, OpenAI-compatible endpoint. Requests are processed and
						forgotten. Sensitive workloads run in Trusted Execution Environments on Aleph Cloud, with remote attestation
						your security team can verify.
					</p>
					<a class="more" href="/api">Explore the API</a>
				</div>
				<div class="shot">
					<div class="mock">
						<div class="mh"><span class="g"></span>enclave · attested</div>
						<div class="pad">
							<div class="lock">
								<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
									><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"
									></path></svg
								>
							</div>
							<div class="hash">sha256:9f2c…a17e · verified</div>
							<div class="chk"><span class="c">✓</span>Nothing stored</div>
							<div class="chk"><span class="c">✓</span>Nothing trained on</div>
							<div class="chk"><span class="c">✓</span>Attested in hardware</div>
						</div>
					</div>
				</div>
			</div>

			<div class="feat rev reveal">
				<div class="txt">
					<span class="mono k">Private agents</span>
					<h3>Agents that work on your data without exposing it.</h3>
					<p>
						LiberClaw runs always-on agents with persistent memory, powered by LibertAI's private inference. Hand them
						internal documents, tickets or code: the models never store or train on what they read.
					</p>
					<a class="more" href="https://liberclaw.ai" target="_blank" rel="noopener">Visit LiberClaw</a>
				</div>
				<div class="shot">
					<div class="mock dark">
						<div class="mh"><span class="g"></span>liberclaw · agents</div>
						<div class="ag">
							<div class="ln"><span>Summarize vendor contracts</span><span class="run">[running]</span></div>
							<div class="ln"><span>Triage support inbox</span><span class="run">[running]</span></div>
							<div class="ln"><span>Review auth middleware</span><span class="done">[done]</span></div>
							<div class="ft">persistent memory · private inference</div>
						</div>
					</div>
				</div>
			</div>

			<div class="feat reveal">
				<div class="txt">
					<span class="mono k">Private tooling for teams</span>
					<h3>Chat and code, on a private endpoint.</h3>
					<p>
						Give every team a private assistant at chat.libertai.io, and give developers LibertAI Code, a coding agent
						wired to a private endpoint. Same daily workflow, without pasting your codebase into someone else's training
						set.
					</p>
					<a class="more" href="https://code.libertai.io" target="_blank" rel="noopener">Try LibertAI Code</a>
				</div>
				<div class="shot">
					<div class="mock dark">
						<div class="mh"><span class="g"></span>code.libertai.io</div>
						<pre>$ libertai code
<span class="ok">→</span> backend api.libertai.io
<span class="ok">→</span> private session · nothing stored
<span class="ok">▌</span></pre>
					</div>
				</div>
			</div>

			<div class="feat rev reveal">
				<div class="txt">
					<span class="mono k">Private web search API</span>
					<h3>Ground your models in the live web, privately.</h3>
					<p>
						Google, Bing and DuckDuckGo queried in parallel, deduplicated and ranked by consensus. No profiling, no
						search history tied to you. From $0.002 per query, on the same credits as inference.
					</p>
					<a class="more" href="/search">Explore Search</a>
				</div>
				<div class="shot">
					<div class="mock">
						<div class="mh"><span class="g"></span>search · consensus</div>
						<div class="pad">
							<div class="qb">
								<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
									><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.3-4.3"></path></svg
								>EU AI Act obligations for deployers
							</div>
							<div class="chk"><span class="c">✓</span>Three engines, one ranked answer</div>
							<div class="chk"><span class="c">✓</span>No profiling, no history</div>
							<div class="chk"><span class="c">✓</span>Clean JSON for your agents</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="blk" style="padding-top:40px">
		<div class="wrap">
			<div class="center reveal">
				<span class="mono k">Why companies choose us</span>
				<h2 class="big">Trust you can audit, not a promise.</h2>
			</div>
			<div class="why">
				<div class="c reveal">
					<span class="mono k">01 · Regulation</span>
					<h4>The EU AI Act is enforced.</h4>
					<p>
						Since August 2026, AI Act obligations are enforced and data control is an audit question, not a slide. GDPR
						compliance is the baseline of every review. Our answer is short: processed, never stored, never trained on.
						<a href="/gdpr">Our GDPR compliance page</a> sets out the commitments.
					</p>
				</div>
				<div class="c reveal">
					<span class="mono k">02 · Jurisdiction</span>
					<h4>An EU company, an EU invoice.</h4>
					<p>
						LibertAI is operated by Intelligence Artificielle Générale SAS, in France. You contract with an EU entity
						and receive an EU invoice.
					</p>
				</div>
				<div class="c reveal">
					<span class="mono k">03 · Portability</span>
					<h4>No vendor lock-in.</h4>
					<p>
						Open-weight models behind an OpenAI-compatible API. Switching in is one line of config, and so is switching
						out. Your prompts and code stay portable.
					</p>
				</div>
				<div class="c reveal">
					<span class="mono k">04 · Verification</span>
					<h4>Verify, don't trust.</h4>
					<p>
						Sensitive workloads run in Trusted Execution Environments on Aleph Cloud. Remote attestation lets your
						security team check the enclave in hardware instead of reading a policy.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="blk" style="padding-top:0">
		<div class="wrap">
			<div class="center reveal">
				<span class="mono k">How we work with you</span>
				<h2 class="big">Start small. Scale on your terms.</h2>
			</div>
			<div class="steps">
				<div class="s reveal">
					<span class="i">01</span><h4>Pilot first</h4><p>
						One team, one scoped use case. We help you set it up, you measure the results, then decide.
					</p>
				</div>
				<div class="s reveal">
					<span class="i">02</span><h4>Migration support</h4><p>
						Your stack already speaks OpenAI. Switch the base URL in one line; we help map models and check your tools
						still work.
					</p>
				</div>
				<div class="s reveal">
					<span class="i">03</span><h4>Startup credits</h4><p>
						Early-stage teams can apply for up to $10,000 in inference credits, reviewed case by case.
					</p>
				</div>
				<div class="s reveal">
					<span class="i">04</span><h4>Custom agreements</h4><p>
						Committed volume gets higher rate limits, direct support and invoicing that fits your procurement. Tailored,
						on request.
					</p>
				</div>
			</div>
			<p class="pnote reveal">
				Self-serve stays open: per-token pricing, no KYC · company agreements on request · <a href="/#pricing"
					>See public pricing</a
				>
			</p>
		</div>
	</section>

	<section style="padding:40px 0 8px">
		<div class="wrap">
			<div class="final reveal">
				<h2>Put private AI to work.</h2>
				<p>Pilot, migration, agents or a tailored agreement: it starts with one email to contact@libertai.io.</p>
				<div class="ctas"><a class="btn acc" href="mailto:contact@libertai.io">Contact us to get our help</a></div>
				<p class="note">We answer within 48 hours. Tell us your use case and constraints.</p>
			</div>
		</div>
	</section>

	<Footer lang="en" />
	<script>
		import { initReveals } from "../scripts/lib/reveals.ts";
		initReveals(0.12);
	</script>
</Base>
