---
// The pill nav shared by all light pages. Base styling (`nav.top` …) lives in
// each page's stylesheet; the responsive burger/mobile-menu rules are global in
// base.css. Desktop links and the mobile panel render from one `links` array.
// Pages outside the main nav (e.g. /claim) omit `active`.
interface Props {
	active?: "home" | "api" | "search" | "services";
	lang?: "en" | "fr";
	/** Path of the same page in the other language, for the EN/FR toggle. */
	alt?: string;
}
const { active, lang = "en", alt } = Astro.props;
const fr = lang === "fr";
const home = active === "home";
const root = fr ? "/fr" : "";
const docsPath = active === "api" ? "apis/" : active === "search" ? "apis/search/" : "";
const docs = `https://docs.libertai.io/${docsPath}`;

// Home-page section anchors resolve in-page on the home page itself (`#models`)
// and cross-page everywhere else, including from /fr back to the FR home.
const anchor = (id: string) => (home ? `#${id}` : `${root}/#${id}`);
const links = [
	{ label: fr ? "Modèles" : "Models", href: anchor("models"), on: false },
	{ label: fr ? "Tarifs" : "Pricing", href: anchor("pricing"), on: false },
	{ label: fr ? "Comparer" : "Compare", href: anchor("compare"), on: false },
	{ label: "API", href: `${root}/api`, on: active === "api" },
	{ label: fr ? "Recherche" : "Search", href: `${root}/search`, on: active === "search" },
	{ label: "Services", href: `${root}/services`, on: active === "services" },
	{ label: "Docs ↗", href: docs, external: true },
];
const ext = (external?: boolean) => (external ? { target: "_blank", rel: "noopener" } : {});
---

<nav class="top">
	<div class="pill">
		<a class="brand" href={home ? "#top" : root || "/"}>Libert<span class="ai">AI</span></a>
		<div class="links">
			{
				links.map((l) => (
					<a class:list={[{ on: l.on }]} href={l.href} {...ext(l.external)}>
						{l.label}
					</a>
				))
			}
		</div>
		<div class="cta">
			{
				alt && (
					<a class="lang" href={alt} hreflang={fr ? "en" : "fr"}>
						{fr ? "EN" : "FR"}
					</a>
				)
			}
			<a class="key" href="https://chat.libertai.io" target="_blank" rel="noopener"
				>{fr ? "Chat privé" : "Chat privately"}</a
			>
		</div>
		<button
			class="burger"
			aria-label={fr ? "Ouvrir le menu" : "Open menu"}
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<span></span><span></span><span></span>
		</button>
	</div>
	<div class="mobilemenu" id="mobile-menu" hidden>
		{
			links.map((l) => (
				<a href={l.href} {...ext(l.external)}>
					{l.label}
				</a>
			))
		}
		{
			alt && (
				<a href={alt} hreflang={fr ? "en" : "fr"}>
					{fr ? "English" : "Français"}
				</a>
			)
		}
		<a href="https://chat.libertai.io" target="_blank" rel="noopener">Chat</a>
		<a class="mkey" href="https://console.libertai.io/api-keys" target="_blank" rel="noopener"
			>{fr ? "Obtenir une clé API" : "Get API key"}</a
		>
	</div>
</nav>

<script>
	const burger = document.querySelector<HTMLButtonElement>("nav.top .burger");
	const menu = document.getElementById("mobile-menu");
	if (burger && menu) {
		const setOpen = (open: boolean) => {
			burger.setAttribute("aria-expanded", String(open));
			burger.classList.toggle("open", open);
			menu.hidden = !open;
		};
		burger.addEventListener("click", () => setOpen(menu.hidden));
		menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
		// collapse if the viewport grows back to the desktop nav
		matchMedia("(min-width: 941px)").addEventListener("change", (e) => {
			if (e.matches) setOpen(false);
		});
	}
</script>
